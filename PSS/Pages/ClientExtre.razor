@page "/extre/{id}"
@using Business.Abstract
@using CoreUI.BackOrder
@using CoreUI.Data
@using System.Net.Http.Headers
@inject IConfiguration configuration
@inject ILogger<ClientFiche> _logger
@inject IServiceProvider _serviceProvider
@inject NavigationManager navManager

<style>
    .extre-wrapper {
        padding: 1rem;
    }

    .filter-card {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: flex-end;
    }

    .filter-field {
        display: flex;
        flex-direction: column;
        min-width: 140px;
        flex: 1 1 140px;
    }

    .filter-field label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #555;
        margin-bottom: 0.25rem;
    }

    .filter-field input.form-control {
        font-size: 0.9rem;
    }

    .filter-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: flex-end;
        flex: 0 0 auto;
    }

    .filter-actions .btn {
        min-width: 100px;
        font-size: 0.9rem;
    }

    /* Responsive tablo */
    .table-responsive-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 8px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    }

    @@media (max-width: 576px) {
        .filter-field {
            flex: 1 1 100%;
        }

        .filter-actions {
            width: 100%;
        }

        .filter-actions .btn {
            flex: 1;
        }
    }

    @@media (max-width: 768px) {
        .extre-wrapper {
            padding: 0.5rem;
        }
    }
</style>
<div class="container">
<div class="extre-wrapper">
    <div class="filter-card">
        <div class="filter-row">
            <div class="filter-field">
                <label>İlk Tarih</label>
                <input type="date" @bind="@firstDate" class="form-control" />
            </div>
            <div class="filter-field">
                <label>Son Tarih</label>
                <input type="date" @bind="@lastDate" class="form-control" />
            </div>
            <div class="filter-actions">
                <button class="btn btn-success" @onclick="() => GetExtre(_currentPage, _rowsPerPage)">
                    Listele
                </button>
                <button class="btn btn-danger" @onclick="@(() => navManager.NavigateTo("/clientlist"))">
                    Cariler
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive-wrapper">
        <DataGrid TItem="ClientFiche" Items="clientFiches" Pager
                  TotalCount="totalCount"
                  RowsPerPage="rowsPerPageChange"
                  SelectedPageChange="selectedPageChange"
        Virtualize>
            <Columns>
                <Column Caption="Tarih"   Field="@nameof(ClientFiche.Date)" />
                <Column Caption="Fiş No"  Field="@nameof(ClientFiche.DocNo)" />
                <Column Caption="Fiş Türü" Field="@nameof(ClientFiche.TrString)" />
                <Column Caption="Açıklama" Field="@nameof(ClientFiche.LineExp)" />
                <Column Caption="Borç"    Field="@nameof(ClientFiche.Debit)"   TextAlign="TextAlignmet.Right" />
                <Column Caption="Alacak"  Field="@nameof(ClientFiche.Credit)"  TextAlign="TextAlignmet.Right" />
                <Column Caption="Bakiye"  Field="@nameof(ClientFiche.Balance)" TextAlign="TextAlignmet.Right" />
            </Columns>
        </DataGrid>
    </div>
</div>
</div>
@code {
    [Parameter]
    public string id { get; set; }

    List<ClientFiche> clientFiches = new List<ClientFiche>();
    private DateTime firstDate { get; set; }
    private DateTime lastDate  { get; set; }
    private int totalCount     { get; set; }
    private int _currentPage   { get; set; } = 0;
    private int _rowsPerPage   { get; set; } = 10;

    [Inject] private ApiStrategyFactory _strategyFactory { get; set; }

    protected override void OnInitialized()
    {
        lastDate  = DateTime.Now;
        firstDate = lastDate.AddMonths(-1);
    }

    private async void GetExtre(int currentPage, int pageSize)
    {
        var strategy = _strategyFactory.GetStrategy();
        clientFiches = await strategy.GetExtre(currentPage, pageSize, id, firstDate, lastDate);
        totalCount = clientFiches.Count;
        StateHasChanged();
    }

    private void rowsPerPageChange(int rowsPerPage)
    {
        _rowsPerPage = rowsPerPage;
        GetExtre(_currentPage, _rowsPerPage);
    }

    private void selectedPageChange(int currentPage)
    {
        _currentPage = currentPage;
        GetExtre(_currentPage, _rowsPerPage);
    }
}