@using Business.SingletonServices
@using Entity
@using Core.Extantaion
@typeparam TItem where TItem : Product
@inject NavigationManager navManager
@inject FirmParameter firmParamService

<div class="card-grid">
    @foreach (var item in Data)
    {
        <div class="product-card">
            <div class="card-image-wrapper" onclick="@(() => trClick(item.Code))">
                <img class="card-image" src="@item.ToImage(0)" alt="@item.Name" />
                <div class="card-overlay">
                    <span class="overlay-text">Detay</span>
                </div>
            </div>

            <div class="card-body">
                <div class="card-code" onclick="@(() => trClick(item.Code))">@item.Code</div>
                <div class="card-name">@item.Name</div>

                @if (firmParamService.ToBoolean(28) && item.ProducerCode != string.Empty)
                {
                    <p class="card-meta">Üretici: @item.ProducerCode</p>
                }
                @if (firmParamService.ToBoolean(29) && item.StGrupCode != string.Empty)
                {
                    <p class="card-meta">Grup: @item.StGrupCode</p>
                }
                @if (firmParamService.ToBoolean(30) && item.SpeCode != string.Empty)
                {
                    <p class="card-meta">Özel Kod1: @item.SpeCode</p>
                }
                @if (firmParamService.ToBoolean(31) && item.SpeCode2 != string.Empty)
                {
                    <p class="card-meta">Özel Kod2: @item.SpeCode2</p>
                }
                @if (firmParamService.ToBoolean(32) && item.SpeCode3 != string.Empty)
                {
                    <p class="card-meta">Özel Kod3: @item.SpeCode3</p>
                }
                @if (firmParamService.ToBoolean(33) && item.SpeCode4 != string.Empty)
                {
                    <p class="card-meta">Özel Kod4: @item.SpeCode4</p>
                }
                @if (firmParamService.ToBoolean(34) && item.SpeCode5 != string.Empty)
                {
                    <p class="card-meta">Özel Kod5: @item.SpeCode5</p>
                }

                <div class="card-stock">
                    @((MarkupString)item.ToMiktar1(firmParamService.ToInteger(23), firmParamService.ToInteger(24)))
                </div>

                <div class="card-prices">
                    <span class="price-label">Özel:</span>
                    <span class="price-value">@item.ToFiyat1(Discount)</span>
                    <span class="price-label">KDVli:</span>
                    <span class="price-value kdv">@item.ToFiyat2(Discount)</span>
                </div>

                <div class="card-order">
                    <input class="card-amount-input" type="number" value="@item.OrderAmount"
                           @oninput="@((e) => item.OrderAmount = Convert.ToDouble(e.Value))" />
                    <button class="card-cart-button" type="button" onclick="@(() => clickAddProduct(item))">
                        <span class="oi oi-cart" aria-hidden="true"></span>
                        Sepete Ekle
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.2rem;
        padding: 1rem 0;
    }

    .product-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.13);
        }

    .card-image-wrapper {
        position: relative;
        cursor: pointer;
        overflow: hidden;
        height: 180px;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .card-image-wrapper:hover .card-image {
        transform: scale(1.06);
    }

    .card-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.32);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .card-image-wrapper:hover .card-overlay {
        opacity: 1;
    }

    .overlay-text {
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
    }

    .card-body {
        padding: 0.85rem 1rem 1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        flex: 1;
    }

    .card-code {
        font-size: 0.75rem;
        color: #888;
        cursor: pointer;
        font-weight: 500;
        letter-spacing: 0.03em;
    }

        .card-code:hover {
            color: #0d6efd;
            text-decoration: underline;
        }

    .card-name {
        font-size: 0.92rem;
        font-weight: 600;
        color: #222;
        line-height: 1.3;
        min-height: 2.4em;
    }

    .card-meta {
        font-size: 0.74rem;
        color: #aaa;
        margin: 0;
    }

    .card-stock {
        font-size: 0.8rem;
        color: #555;
        margin-top: 0.2rem;
    }

    .card-prices {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
        margin-top: 0.3rem;
    }

    .price-label {
        font-size: 0.72rem;
        color: #aaa;
    }

    .price-value {
        font-size: 0.88rem;
        font-weight: 600;
        color: #333;
    }

        .price-value.kdv {
            color: #0d6efd;
        }

    .card-order {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: auto;
        padding-top: 0.7rem;
    }

    .card-amount-input {
        width: 64px;
        padding: 0.3rem 0.4rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 0.88rem;
        text-align: center;
    }

    .card-cart-button {
        flex: 1;
        padding: 0.4rem 0.5rem;
        background: #0d6efd;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
        transition: background 0.15s ease;
    }

        .card-cart-button:hover {
            background: #0b5ed7;
        }
</style>

@code {
    [Parameter]
    public IEnumerable<TItem> Data { get; set; } = default!;

    [Parameter]
    public EventCallback<Product> AddProduct { get; set; }

    public double Discount { get; set; } = 0;

    private void clickAddProduct(Product Data)
    {
        AddProduct.InvokeAsync(Data);
    }

    private void trClick(string code)
    {
        navManager.NavigateTo($"/product?code={code}", true);
    }
}
