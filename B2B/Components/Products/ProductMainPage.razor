@page "/Products"

@using B2B.Data
@using Business.SingletonServices
@using Core.Abstract
@using CoreUI.Components.Base
@using CoreUI.Components.NotificationService
@using CoreUI.Components.Pagenation
@using CoreUI.Components.UserPanel
@using Entity
@inject CartService cartService
@inject IUserIdentityProcessor userIdentity
@inject NotificationService notification
@inject FirmParameter firmParamService

@attribute [Authorize]

<style>
    .view-toggle {
        display: inline-flex;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        margin-left: 0.75rem;
        vertical-align: middle;
    }

    .view-btn {
        padding: 0.35rem 0.85rem;
        background: #fff;
        border: none;
        font-size: 0.83rem;
        font-weight: 500;
        color: #666;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        transition: background 0.15s, color 0.15s;
    }

        .view-btn:not(:last-child) {
            border-right: 1px solid #dee2e6;
        }

        .view-btn.active {
            background: #0d6efd;
            color: #fff;
        }

        .view-btn:hover:not(.active) {
            background: #f0f4ff;
            color: #0d6efd;
        }
</style>

<div class="container">
    <div class="findarea">
        <form @onsubmit="SearchEnter">
            <input class="findtext" type="text" placeholder="Arama" id="filter" name="filter" @bind-value="@Filter" />
            <input type="hidden" id="category" name="category" value="@selectCategory" />
            <input class="btn btn-outline-primary my-2 my-sm-0" style="border-radius:20px;" type="submit" />

            <div class="view-toggle">
                <button type="button"
                        class="view-btn @(isCardView ? "" : "active")"
                        title="Tablo Görünümü"
                        @onclick="() => isCardView = false">
                    <span class="oi oi-list" aria-hidden="true"></span>
                    DataGrid
                </button>
                <button type="button"
                        class="view-btn @(isCardView ? "active" : "")"
                        title="Kart Görünümü"
                        @onclick="() => isCardView = true">
                    <span class="oi oi-grid-four-up" aria-hidden="true"></span>
                    Kart
                </button>
            </div>

        </form>
    </div>

    @if (isCardView)
    {
        <CardView TItem="Product" Data="pdata.Results" AddProduct="addproduct" />
    }
    else
    {
        <DataGridView TItem="Product" Data="pdata.Results" AddProduct="addproduct" />
    }
    <Pager Result="@pdata" PageChanged="PagerPageChanged" PageSize="pdata.PageSize" RowCount="pdata.RowCount" OnPageSizeChanged="pageSizeOnchanged" />
</div>

@code {

    private bool isCardView = false;

    protected override void OnParametersSet()
    {


        if (firmParamService.ToInteger(17) == 0)
        {
            isCardView = true;
        }
    }

    private void SearchEnter()
    {
        PagerPageChanged(0);
    }

    private async void addproduct(Product product)
    {
        Guid UserId = await userIdentity.GetCurrentUserId();
        var result1 = await cartService.AddUserCart(product.Id, product.PriceLists[0]?.Price ?? 0, product.OrderAmount, 0, UserId);
        notification.Notify(new NotificationMessage { Severity = result1.Status, Summary = result1.Status.ToString(), Detail = result1.Message, Duration = 2000 });

    }


}